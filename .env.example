# Telegram bot token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=

# Optional: fixes the main chat that receives push alerts for all
# printers. If omitted, the first confirmed allowlist user who writes to
# the bot is used.
TELEGRAM_MAIN_CHAT_ID=

# Port the REST API listens on (rest/both mode)
REST_API_PORT=8080

# Token required (header "Authorization: Bearer <token>") to use the REST
# API. If left empty, the API is disabled for security.
REST_API_TOKEN=
